# Install as /etc/mqtt-portal-backup.conf (root:root, mode 600).
BACKUP_DIR=/var/backups/mqtt-portal
BACKUP_KEY_FILE=/root/.config/mqtt-portal/backup.key
BACKUP_KEEP_DAYS=30

# Strongly recommended: an rclone destination on a different provider/account.
# Example: MQTT_BACKUP_REMOTE=backblaze:mqtt-portal-vultr
MQTT_BACKUP_REMOTE=

