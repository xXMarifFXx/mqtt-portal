<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>MQTT Portal — Admin</title>
<link rel="stylesheet" href="/static/style.css">
</head><body>
<main class="card wide">
  <div class="row spread">
    <h1>Admin</h1>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ghost">Log out</button></form>
  </div>
  <% if (ok)  { %><div class="ok inline"><%= ok %></div><% } %>
  <% if (error) { %><div class="err"><%= error %></div><% } %>

  <!-- ===== Live devices ===== -->
  <h3 class="sectionhead">Live devices</h3>
  <p class="sub">Which students' boards are connected right now (auto-refreshes every few seconds).</p>
  <% if (monitorHealth.ready) { %><div class="ok inline">Status monitor connected with its read-only account.</div>
  <% } else { %><div class="err">Status monitor is unavailable. Device presence may be stale; check <code>/readyz</code> and service logs.</div><% } %>
  <div id="devices"><em class="muted">Loading…</em></div>

  <!-- ===== Students ===== -->
  <h3 class="sectionhead">Students <span class="count"><%= rows.length %></span></h3>
  <% if (rows.length === 0) { %>
    <p class="sub">No student accounts yet. Add one below, or share the registration link + a class code.</p>
  <% } else { %>
  <table>
    <thead><tr><th>Username</th><th>Name</th><th>Created</th><th>Reset password</th><th>On/off</th><th></th></tr></thead>
    <tbody>
    <% rows.forEach(function(r){ %>
      <tr>
        <td><code><%= r.username %></code><% if (r.disabled) { %> <span class="muted">(off)</span><% } %><% if (r.retentionExpired) { %> <span class="badge warn">retention due</span><% } %></td>
        <td><%= r.displayName || '—' %></td>
        <td class="muted"><%= r.createdAt ? r.createdAt.slice(0,10) : '—' %></td>
        <td>
          <form method="post" action="/admin/reset" class="inlineform">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="username" value="<%= r.username %>">
            <input name="password" type="text" placeholder="new password" minlength="8" required>
            <button>Reset</button>
          </form>
        </td>
        <td>
          <% if (r.disabled) { %>
            <form method="post" action="/admin/enable">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="username" value="<%= r.username %>"><button>Turn on</button>
            </form>
          <% } else { %>
            <form method="post" action="/admin/disable" data-confirm="Turn off <%= r.username %>? Their board is forced offline until you turn it back on.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="username" value="<%= r.username %>"><button class="ghost">Turn off</button>
            </form>
          <% } %>
        </td>
        <td>
          <form method="post" action="/admin/delete" data-confirm="Delete <%= r.username %>?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="username" value="<%= r.username %>">
            <button class="danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table>
  <% } %>

  <!-- Add a student manually -->
  <div class="panel">
    <b>Add a student</b>
    <form method="post" action="/admin/student/add" class="addrow" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="username" placeholder="username (e.g. ada)" pattern="[a-zA-Z][a-zA-Z0-9_\-]{2,19}" required>
      <input name="display" placeholder="name (optional)" maxlength="60">
      <input name="password" type="text" placeholder="password (min 8)" minlength="8" required>
      <button>Create</button>
    </form>
    <small class="muted">Scoped to <code>devices/&lt;username&gt;/#</code>, same as self-registration.</small>
  </div>
  <div class="panel">
    <b>Data retention</b>
    <p class="hint">Accounts are due for deletion after <%= privacy.retentionDays %> days. Rows marked “retention due” should be reviewed and deleted, or use the dry-run cleanup command documented in <code>deploy/privacy/README.md</code>.</p>
    <a href="/privacy">View student privacy notice</a>
  </div>

  <!-- ===== Class codes ===== -->
  <h3 class="sectionhead">Class codes <span class="count"><%= codes.length %></span></h3>
  <p class="sub">Students must enter one of these to self-register. Rotate them per term.</p>
  <% if (codes.length === 0) { %>
    <div class="err">No active codes — self-registration is closed until you add one.</div>
  <% } else { %>
  <table>
    <thead><tr><th>Code</th><th>Added</th><th></th></tr></thead>
    <tbody>
    <% codes.forEach(function(c){ %>
      <tr>
        <td><code><%= c.code %></code></td>
        <td class="muted"><%= c.addedAt ? c.addedAt.slice(0,10) : '—' %></td>
        <td>
          <form method="post" action="/admin/code/delete" data-confirm="Remove code <%= c.code %>?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="code" value="<%= c.code %>">
            <button class="danger">Remove</button>
          </form>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table>
  <% } %>
  <div class="panel">
    <b>Add a class code</b>
    <form method="post" action="/admin/code/add" class="addrow">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="code" placeholder="new class code (3–64 chars)" minlength="3" maxlength="64" required>
      <button>Add code</button>
    </form>
  </div>
</main>
<script src="/static/confirm.js"></script>
<script src="/static/devices.js"></script>
</body></html>
