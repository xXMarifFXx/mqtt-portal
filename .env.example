# Copy to .env and fill in. Never commit the real .env.

# --- app ---
PORT=3000
HOST=127.0.0.1                # keep localhost; nginx terminates TLS in front
SESSION_SECRET=               # run: openssl rand -hex 32
COOKIE_SECURE=true            # true when served over HTTPS (set false for local http dev)

# --- registration + connection info shown to students ---
CLASS_CODE=change-me-each-term      # students must enter this to register
PUBLIC_BROKER_HOST=mqtt.mariffb.my  # your domain; shown to students for their sketch
PUBLIC_BROKER_PORT=8883             # MQTT-over-TLS port (devices connect here)
PUBLIC_BROKER_WS_PORT=8084          # MQTT-over-WebSocket-TLS port (browser test console)

# --- admin login ---
# Generate with:  npm run hashpw -- 'your admin password'
ADMIN_PASSWORD_HASH=

# --- broker control (Mosquitto Dynamic Security) ---
DYNSEC_MODE=real             # 'mock' to run the UI with no broker (dev/testing)
BROKER_CTRL_HOST=127.0.0.1   # local control listener (see deploy/enable-dynsec.sh)
BROKER_CTRL_PORT=1883
DYNSEC_ADMIN_USER=dynsec-admin
DYNSEC_ADMIN_PASS=           # the dynsec admin password from `mosquitto_ctrl dynsec init`
STUDENT_ROLE=student         # the %u-scoped role created by enable-dynsec.sh
